[sub_resource type="Shader" id="Shader_1flx1"]
code = "shader_type canvas_item;

uniform float flash_amount : hint_range(0.0, 1.0) = 0.0;
uniform vec4 flash_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);

uniform sampler2D noise_tex;
uniform float dissolve_amount : hint_range(0.0, 1.0) = 0.0;

// 定义一个 varying 变量用来接收节点的 modulate 颜色
varying vec4 mod_color;

void vertex() {
    // 在顶点阶段捕获节点的 modulate / self_modulate 颜色和透明度
    mod_color = COLOR;
}

void fragment() {
    vec4 tex_color = texture(TEXTURE, UV);
    
    // 1. 闪烁混合
    vec3 final_color = mix(tex_color.rgb, flash_color.rgb, flash_amount);
    
    // 2. 像素风消散
    float noise_val = texture(noise_tex, UV).r;
    float alpha = tex_color.a * step(dissolve_amount, noise_val);
    
    // 3. 输出最终颜色，并乘以 mod_color 使得节点的 modulate 重新恢复作用
    COLOR = vec4(final_color, alpha) * mod_color;
}"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_lmosj"]

